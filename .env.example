# Copy to .env in this folder. Each provider app reads this file.
# A provider folder .env overrides these values for that provider only.
# Do not commit .env.

# --- AWS S3 (folder: aws, library provider: s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# Optional separate buckets. If empty, AWS_BUCKET is used for both.
AWS_PUBLIC_BUCKET=
AWS_PRIVATE_BUCKET=
# Optional
AWS_SESSION_TOKEN=
AWS_ENDPOINT=
AWS_CDN_URL=
AWS_CUSTOM_DOMAIN=

# --- Azure Blob (folder: azure, library provider: azure) ---
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
# Optional. Signed private URLs still need AZURE_ACCOUNT_KEY.
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=
AZURE_PUBLIC_CONTAINER=
AZURE_PRIVATE_CONTAINER=
AZURE_CDN_URL=
AZURE_CUSTOM_DOMAIN=

# --- Google Cloud Storage (folder: gcp, library provider: gcs) ---
GCP_PROJECT_ID=
GCP_BUCKET=
GCP_PUBLIC_BUCKET=
GCP_PRIVATE_BUCKET=
# Use a service-account JSON file, or the email + private key pair.
GCP_KEY_FILENAME=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_CDN_URL=
GCP_CUSTOM_DOMAIN=
